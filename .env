# OpenSearch version
OPENSEARCH_VERSION=2.18.0

# OpenSearch JVM heap. Bump to 1g+ if you have the RAM.
OPENSEARCH_HEAP=512m

# Interface Kamailio's SIP ports bind to on the host.
#   0.0.0.0   = reachable from the internet (real honeypot deployment)
#   127.0.0.1 = local testing only
SIP_BIND=0.0.0.0
